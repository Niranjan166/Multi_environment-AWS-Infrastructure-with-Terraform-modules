# ── Terraform State Files ──────────────────────────────
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
 
# ── Terraform Directory ────────────────────────────────
**/.terraform/
.terraform/
 
# ── Terraform Lock File ────────────────────────────────
.terraform.lock.hcl
 
# ── Variable Files (contain sensitive values) ──────────
*.tfvars
!environment/dev/dev/*.tfvars
!environment/staging/staging/*.tfvars
!environment/prod/prod/*.tfvars
 
# ── Crash Logs ─────────────────────────────────────────
crash.log
crash.*.log
 
# ── Override Files ─────────────────────────────────────
override.tf
override.tf.json
*_override.tf
*_override.tf.json
 
# ── CLI Config ─────────────────────────────────────────
.terraformrc
terraform.rc
 
# ── Environment Variables ──────────────────────────────
.env
.env.*
 
# ── OS Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
 
# ── IDE Files ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo